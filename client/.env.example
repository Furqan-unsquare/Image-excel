# Copy this file to ".env" (optional – the defaults work for local development).

# Where the API runs during development. Vite forwards every /api request there.
VITE_PROXY_TARGET=http://localhost:5000

# Production only: full URL of the deployed API, e.g. https://api.myschool.com
# Leave empty when the app and API are served from the same domain.
VITE_API_URL=

# Port for the development server
PORT=5173
