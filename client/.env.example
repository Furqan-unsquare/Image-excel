# Client settings. Copy to:
#   .env             -> development (npm run dev)
#   .env.production  -> production build (npm run build)
# On Netlify / Vercel / Render set VITE_API_URL in the site's environment variables.

# Production: address of the deployed API, without "/api" at the end.
#   VITE_API_URL=https://papersheet-api.onrender.com
# Development: leave empty – Vite forwards /api to VITE_PROXY_TARGET.
VITE_API_URL=https://image-excel-n3f5.onrender.com/

# Development only: where the API runs on your PC.
VITE_PROXY_TARGET=http://localhost:5000

# Development only: port for the dev server.
PORT=5173
