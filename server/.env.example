# Copy this file to ".env" and fill in the values.

# Port for the API (the client's Vite dev server forwards /api to it)
PORT=5000

# MongoDB connection string – local or MongoDB Atlas, e.g.
#   mongodb://127.0.0.1:27017/image_to_excel
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/image_to_excel
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23).
# Test it with:  npm run check-db
MONGODB_URI=mongodb://127.0.0.1:27017/image_to_excel

# Public DNS servers used automatically when this PC cannot resolve an Atlas
# "mongodb+srv://" address (error: querySrv ECONNREFUSED). Usually no need to change.
DNS_SERVERS=8.8.8.8,1.1.1.1

# Groq API key from https://console.groq.com/keys
# Needed for good results: reads handwriting and understands the question structure.
# Without it the app still works for printed papers using Tesseract OCR + built-in rules.
# Free tier: the vision model allows ~7000 image tokens per minute (about 3-4 photos);
# the app waits automatically when the limit is reached.
GROQ_API_KEY=

# Groq models (change only if Groq renames/retires them: https://console.groq.com/docs/models)
# Vision model = reads the photos. Text model = turns the text into questions/marks.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# What to do when Groq is missing or fails: "tesseract" (free basic OCR) or "none"
OCR_FALLBACK=tesseract

# Upload limits
MAX_IMAGES=10
MAX_IMAGE_MB=15
MAX_TEMPLATE_MB=5

# Allowed browser origins for the API ("*" = any). Example: https://papers.myschool.com
CORS_ORIGIN=*

# Add the sample .xlsx files from server/seed when the database has no formats yet
SEED_SAMPLE_TEMPLATES=true

# Optional: serve the built client from this server (single deployment).
# Build the client first (cd ../client && npm run build), then set:
# CLIENT_DIST_DIR=../client/dist
CLIENT_DIST_DIR=
